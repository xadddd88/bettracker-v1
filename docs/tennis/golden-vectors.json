{
  "schema": "tennis/golden-vectors@1",
  "note": "Shared authority for TypeScript (PR-1) and SQL (PR-2). Money as decimal strings, 2dp; odds as decimal strings, up to 3dp. Fields ending _minor carry raw integer minor units (money) as strings and odds_scaled carries raw scaled odds, injected directly to exercise the math/state layer's own validators (bypassing the string parser). Amounts are minor-unit exact.",
  "scales": { "moneyScale": 100, "oddsScale": 1000, "minOddsScaled": 1010, "maxOddsScaled": 20000, "maxMoneyMinor": "10000000000", "maxGames": 15 },
  "default_target": [
    { "name": "canonical $20 @ 3.34", "startingStake": "20.00", "openingOdds": "3.34", "expectedDefaultTarget": "46.80" },
    { "name": "$20 @ 2.90", "startingStake": "20.00", "openingOdds": "2.90", "expectedDefaultTarget": "38.00" }
  ],
  "required_stake": [
    { "name": "V1 game1 canonical", "L": "0.00", "P": "46.80", "odds": "3.34", "step": "0.01", "expectedRequired": "20.00" },
    { "name": "V2 WTA 2.90 mid-series ceil", "L": "20.00", "P": "46.80", "odds": "2.90", "step": "0.01", "expectedRequired": "35.16" },
    { "name": "V3 WTA 3.05 mid-series ceil", "L": "20.00", "P": "46.80", "odds": "3.05", "step": "0.01", "expectedRequired": "32.59" },
    { "name": "V4 WTA 3.18 mid-series ceil", "L": "20.00", "P": "46.80", "odds": "3.18", "step": "0.01", "expectedRequired": "30.65" },
    { "name": "V5 ATP 3.34 mid-series ceil", "L": "20.00", "P": "46.80", "odds": "3.34", "step": "0.01", "expectedRequired": "28.55" },
    { "name": "V6 ATP 3.45 above prior range", "L": "20.00", "P": "46.80", "odds": "3.45", "step": "0.01", "expectedRequired": "27.27" },
    { "name": "V7 ceil on fractional cent", "L": "0.00", "P": "1.00", "odds": "3.05", "step": "0.01", "expectedRequired": "0.49" },
    { "name": "V9 odds lower bound 1.010", "L": "0.00", "P": "1.00", "odds": "1.010", "step": "0.01", "expectedRequired": "100.00" },
    { "name": "V10 odds upper bound 20.000", "L": "0.00", "P": "1.00", "odds": "20.000", "step": "0.01", "expectedRequired": "0.06" },
    { "name": "V-step round up to $1 step", "L": "0.00", "P": "1.00", "odds": "3.05", "step": "1.00", "expectedRequired": "1.00" }
  ],
  "win_profit": [
    { "name": "win meets target exactly", "actualStake": "20.00", "odds": "3.34", "LBefore": "0.00", "targetProfit": "46.80", "expectedProfit": "46.80", "expectedTargetMet": true },
    { "name": "win small stake meets $1", "actualStake": "0.49", "odds": "3.05", "LBefore": "0.00", "targetProfit": "1.00", "expectedProfit": "1.00", "expectedTargetMet": true },
    { "name": "actual below required -> target_met false on win", "actualStake": "15.00", "odds": "3.34", "LBefore": "0.00", "targetProfit": "46.80", "expectedProfit": "35.10", "expectedTargetMet": false }
  ],
  "reject": [
    { "name": "money 3dp", "kind": "money", "input": "1.005", "expectedCode": "money_precision" },
    { "name": "money non-numeric", "kind": "money", "input": "abc", "expectedCode": "money_format" },
    { "name": "money over sanity", "kind": "money", "input": "1000000000.00", "expectedCode": "money_out_of_range" },
    { "name": "odds below 1.010", "kind": "odds", "input": "1.009", "expectedCode": "odds_out_of_range" },
    { "name": "odds above 20.000", "kind": "odds", "input": "20.001", "expectedCode": "odds_out_of_range" },
    { "name": "odds 4dp", "kind": "odds", "input": "3.0500", "expectedCode": "odds_precision" },
    { "name": "odds non-numeric", "kind": "odds", "input": "xyz", "expectedCode": "odds_format" }
  ],
  "math_reject": [
    { "name": "requiredStake scaled odds below range", "fn": "requiredStakeMinor", "L": "0.00", "P": "1.00", "odds_scaled": 1009, "expectedCode": "odds_out_of_range" },
    { "name": "requiredStake scaled odds above range", "fn": "requiredStakeMinor", "L": "0.00", "P": "1.00", "odds_scaled": 20001, "expectedCode": "odds_out_of_range" },
    { "name": "requiredStake scaled odds == 1.000", "fn": "requiredStakeMinor", "L": "0.00", "P": "1.00", "odds_scaled": 1000, "expectedCode": "odds_out_of_range" },
    { "name": "requiredStake L above ceiling (direct bigint)", "fn": "requiredStakeMinor", "L_minor": "10000000001", "P_minor": "0", "odds_scaled": 3000, "expectedCode": "input_out_of_range" },
    { "name": "requiredStake negative L", "fn": "requiredStakeMinor", "L_minor": "-1", "P_minor": "0", "odds_scaled": 3000, "expectedCode": "negative_input" },
    { "name": "requiredStake computed output overflow (aggregate at ceiling, division overflows)", "fn": "requiredStakeMinor", "L": "50000000.00", "P": "50000000.00", "odds": "1.010", "expectedCode": "output_out_of_range" },
    { "name": "requiredStake aggregate L+P over ceiling", "fn": "requiredStakeMinor", "L_minor": "10000000000", "P_minor": "1", "odds_scaled": 3000, "expectedCode": "aggregate_out_of_range" },
    { "name": "meetsTargetByProduct aggregate L+P over ceiling", "fn": "meetsTargetByProduct", "req_minor": "1", "L_minor": "10000000000", "P_minor": "1", "odds_scaled": 3000, "expectedCode": "aggregate_out_of_range" },
    { "name": "roundUpToStep negative minor", "fn": "roundUpToStep", "minor_minor": "-1", "step_minor": "1", "expectedCode": "negative_input" },
    { "name": "roundUpToStep bad step 0", "fn": "roundUpToStep", "minor_minor": "100", "step_minor": "0", "expectedCode": "bad_step" },
    { "name": "roundUpToStep step above ceiling", "fn": "roundUpToStep", "minor_minor": "100", "step_minor": "10000000001", "expectedCode": "input_out_of_range" },
    { "name": "roundUpToStep minor (amount) above ceiling", "fn": "roundUpToStep", "minor_minor": "10000000001", "step_minor": "1", "expectedCode": "input_out_of_range" },
    { "name": "actualProfit stake above ceiling", "fn": "actualProfitMinor", "actualStake_minor": "10000000001", "LBefore_minor": "0", "odds_scaled": 3000, "expectedCode": "input_out_of_range" },
    { "name": "actualProfit scaled odds out of range", "fn": "actualProfitMinor", "actualStake": "20.00", "LBefore": "0.00", "odds_scaled": 20050, "expectedCode": "odds_out_of_range" },
    { "name": "targetMet negative target", "fn": "targetMet", "profit_minor": "100", "target_minor": "-1", "expectedCode": "negative_target" },
    { "name": "targetMet profit above ceiling", "fn": "targetMet", "profit_minor": "10000000001", "target_minor": "0", "expectedCode": "input_out_of_range" },
    { "name": "targetMet target above ceiling", "fn": "targetMet", "profit_minor": "0", "target_minor": "10000000001", "expectedCode": "input_out_of_range" },
    { "name": "meetsTargetByProduct odds out of range", "fn": "meetsTargetByProduct", "req_minor": "2000", "L_minor": "0", "P_minor": "100", "odds_scaled": 1000, "expectedCode": "odds_out_of_range" },
    { "name": "meetsTargetByProduct requiredStake above ceiling", "fn": "meetsTargetByProduct", "req_minor": "10000000001", "L_minor": "0", "P_minor": "0", "odds_scaled": 3000, "expectedCode": "input_out_of_range" },
    { "name": "defaultTarget starting above ceiling", "fn": "defaultTargetProfitMinor", "startingStake_minor": "10000000001", "odds_scaled": 3000, "expectedCode": "input_out_of_range" },
    { "name": "requiredStakeMinorRaw direct input L above ceiling", "fn": "requiredStakeMinorRaw", "L_minor": "10000000001", "P_minor": "0", "odds_scaled": 3000, "expectedCode": "input_out_of_range" },
    { "name": "requiredStakeMinorRaw aggregate L+P above ceiling", "fn": "requiredStakeMinorRaw", "L_minor": "10000000000", "P_minor": "1", "odds_scaled": 3000, "expectedCode": "aggregate_out_of_range" }
  ],
  "limits": [
    { "name": "required over remaining bank", "requiredStake": "35.16", "actualStake": "35.16", "L": "20.00", "remainingBank": "30.00", "perBetLimit": "100.00", "seriesExposureLimit": "1000.00", "expectedOk": false, "expectedReason": "required_exceeds_remaining_bank" },
    { "name": "actual over remaining bank", "requiredStake": "20.00", "actualStake": "35.00", "L": "0.00", "remainingBank": "30.00", "perBetLimit": "100.00", "seriesExposureLimit": "1000.00", "expectedOk": false, "expectedReason": "actual_exceeds_remaining_bank" },
    { "name": "required over per-bet", "requiredStake": "35.00", "actualStake": "10.00", "L": "0.00", "remainingBank": "100.00", "perBetLimit": "30.00", "seriesExposureLimit": "1000.00", "expectedOk": false, "expectedReason": "required_exceeds_per_bet_limit" },
    { "name": "actual over per-bet", "requiredStake": "20.00", "actualStake": "35.00", "L": "0.00", "remainingBank": "100.00", "perBetLimit": "30.00", "seriesExposureLimit": "1000.00", "expectedOk": false, "expectedReason": "actual_exceeds_per_bet_limit" },
    { "name": "required over series exposure", "requiredStake": "35.16", "actualStake": "35.16", "L": "20.00", "remainingBank": "100.00", "perBetLimit": "100.00", "seriesExposureLimit": "50.00", "expectedOk": false, "expectedReason": "required_exceeds_series_exposure" },
    { "name": "actual over series exposure", "requiredStake": "10.00", "actualStake": "40.00", "L": "20.00", "remainingBank": "100.00", "perBetLimit": "100.00", "seriesExposureLimit": "55.00", "expectedOk": false, "expectedReason": "actual_exceeds_series_exposure" },
    { "name": "within all limits", "requiredStake": "20.00", "actualStake": "20.00", "L": "0.00", "remainingBank": "100.00", "perBetLimit": "100.00", "seriesExposureLimit": "1000.00", "expectedOk": true }
  ],
  "limit_reject": [
    { "name": "negative remaining bank", "requiredStake": "10.00", "actualStake": "10.00", "L": "0.00", "remainingBank_minor": "-1", "perBetLimit": "100.00", "seriesExposureLimit": "1000.00", "expectedCode": "negative_input" },
    { "name": "per-bet limit above ceiling", "requiredStake": "10.00", "actualStake": "10.00", "L": "0.00", "remainingBank": "100.00", "perBetLimit_minor": "10000000001", "seriesExposureLimit": "1000.00", "expectedCode": "input_out_of_range" },
    { "name": "series exposure aggregate L+required over ceiling", "requiredStake_minor": "1", "actualStake_minor": "1", "L_minor": "10000000000", "remainingBank_minor": "10000000000", "perBetLimit_minor": "10000000000", "seriesExposureLimit_minor": "10000000000", "expectedCode": "aggregate_out_of_range" }
  ],
  "state_cases": [
    { "name": "loss adds actual to realizedLoss", "action": "settle", "result": "lost", "targetProfit": "46.80",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "20.00", "pending": { "gameNumber": 1, "actualStake": "35.16", "odds": "2.90", "required": "35.16" } },
      "expect": { "seriesState": "open", "realizedLoss": "55.16", "gamesUsed": 1, "betState": "lost" } },
    { "name": "void keeps realizedLoss unchanged", "action": "settle", "result": "void", "targetProfit": "46.80",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "20.00", "pending": { "gameNumber": 1, "actualStake": "35.16", "odds": "2.90", "required": "35.16" } },
      "expect": { "seriesState": "open", "realizedLoss": "20.00", "gamesUsed": 1, "betState": "void" } },
    { "name": "win computes profit and target_met true", "action": "settle", "result": "won", "targetProfit": "46.80",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": { "gameNumber": 1, "actualStake": "20.00", "odds": "3.34", "required": "20.00" } },
      "expect": { "seriesState": "won", "betState": "won", "actualProfit": "46.80", "targetMet": true } },
    { "name": "win target_met false when actual below required", "action": "settle", "result": "won", "targetProfit": "46.80",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": { "gameNumber": 1, "actualStake": "15.00", "odds": "3.34", "required": "20.00" } },
      "expect": { "seriesState": "won", "betState": "won", "actualProfit": "35.10", "targetMet": false } },
    { "name": "win after previous realizedLoss", "action": "settle", "result": "won", "targetProfit": "20.00",
      "series": { "state": "open", "gamesUsed": 2, "realizedLoss": "40.00", "pending": { "gameNumber": 3, "actualStake": "30.00", "odds": "3.00", "required": "30.00" } },
      "expect": { "seriesState": "won", "betState": "won", "actualProfit": "20.00", "targetMet": true } },
    { "name": "game 15 loss stops with max_games", "action": "settle", "result": "lost", "targetProfit": "5.00",
      "series": { "state": "open", "gamesUsed": 14, "realizedLoss": "100.00", "pending": { "gameNumber": 15, "actualStake": "10.00", "odds": "3.00", "required": "10.00" } },
      "expect": { "seriesState": "stopped", "stopReason": "max_games", "realizedLoss": "110.00", "gamesUsed": 15, "betState": "lost" } },
    { "name": "game 15 void stops with max_games", "action": "settle", "result": "void", "targetProfit": "5.00",
      "series": { "state": "open", "gamesUsed": 14, "realizedLoss": "100.00", "pending": { "gameNumber": 15, "actualStake": "10.00", "odds": "3.00", "required": "10.00" } },
      "expect": { "seriesState": "stopped", "stopReason": "max_games", "realizedLoss": "100.00", "gamesUsed": 15, "betState": "void" } },
    { "name": "successful open keeps actual and required separate", "action": "open", "bet": { "actualStake": "15.00", "odds": "3.34", "required": "20.00" },
      "series": { "state": "open", "gamesUsed": 1, "realizedLoss": "20.00", "pending": null },
      "expect": { "gameNumber": 2, "pendingActualStake": "15.00", "pendingRequiredStake": "20.00" } },
    { "name": "settled bet keeps actual and required separate", "action": "settle", "result": "lost", "targetProfit": "46.80",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": { "gameNumber": 1, "actualStake": "15.00", "odds": "3.34", "required": "20.00" } },
      "expect": { "seriesState": "open", "realizedLoss": "15.00", "betState": "lost", "betActualStake": "15.00", "betRequiredStake": "20.00" } },
    { "name": "stop with pending is blocked", "action": "stop",
      "series": { "state": "open", "gamesUsed": 2, "realizedLoss": "40.00", "pending": { "gameNumber": 3, "actualStake": "10.00", "odds": "3.00", "required": "10.00" } },
      "expect": { "errorCode": "pending_bet_exists" } },
    { "name": "manual stop from open with no pending", "action": "stop",
      "series": { "state": "open", "gamesUsed": 2, "realizedLoss": "40.00", "pending": null },
      "expect": { "seriesState": "stopped", "stopReason": "manual" } },
    { "name": "game 16 blocked at open", "action": "open", "bet": { "actualStake": "10.00", "odds": "3.00", "required": "10.00" },
      "series": { "state": "open", "gamesUsed": 15, "realizedLoss": "200.00", "pending": null },
      "expect": { "errorCode": "max_games" } },
    { "name": "open blocked when a pending bet exists", "action": "open", "bet": { "actualStake": "10.00", "odds": "3.00", "required": "10.00" },
      "series": { "state": "open", "gamesUsed": 1, "realizedLoss": "20.00", "pending": { "gameNumber": 2, "actualStake": "10.00", "odds": "3.00", "required": "10.00" } },
      "expect": { "errorCode": "pending_bet_exists" } },
    { "name": "open rejects invalid odds", "action": "open", "bet": { "actualStake": "10.00", "odds_scaled": 1009, "required": "10.00" },
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "odds_out_of_range" } },
    { "name": "loss crossing the money ceiling is blocked", "action": "settle", "result": "lost", "targetProfit": "1.00",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss_minor": "10000000000", "pending": { "gameNumber": 1, "actualStake": "0.01", "odds": "3.00", "required": "0.01" } },
      "expect": { "errorCode": "loss_exceeds_ceiling" } },
    { "name": "settle rejects negative target", "action": "settle", "result": "won", "targetProfit_minor": "-1",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": { "gameNumber": 1, "actualStake": "20.00", "odds": "3.34", "required": "20.00" } },
      "expect": { "errorCode": "negative_target" } },
    { "name": "invalid negative gamesUsed", "action": "stop",
      "series": { "state": "open", "gamesUsed": -1, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "invalid fractional gamesUsed", "action": "stop",
      "series": { "state": "open", "gamesUsed": 3.5, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "invalid gamesUsed above max", "action": "stop",
      "series": { "state": "open", "gamesUsed": 16, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "invalid nextGameNumber snapshot", "action": "nextGameNumber",
      "series": { "state": "open", "gamesUsed": 3.5, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "nextGameNumber returns next ordinal at game 14", "action": "nextGameNumber",
      "series": { "state": "open", "gamesUsed": 14, "realizedLoss": "0.00", "pending": null },
      "expect": { "gameNumber": 15 } },
    { "name": "nextGameNumber blocked at max games (gamesUsed 15)", "action": "nextGameNumber",
      "series": { "state": "open", "gamesUsed": 15, "realizedLoss": "200.00", "pending": null },
      "expect": { "errorCode": "max_games" } },
    { "name": "won state at game zero is invalid", "action": "validate",
      "series": { "state": "won", "gamesUsed": 0, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "won state at game one is valid", "action": "validate",
      "series": { "state": "won", "gamesUsed": 1, "realizedLoss": "0.00", "pending": null },
      "expect": {} },
    { "name": "realizedLoss above ceiling", "action": "stop",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss_minor": "10000000001", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "pending odds out of range", "action": "stop",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": { "gameNumber": 1, "actualStake": "10.00", "odds_scaled": 20001, "required": "10.00" } },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "open state must not carry stopReason", "action": "stop",
      "series": { "state": "open", "gamesUsed": 1, "realizedLoss": "0.00", "pending": null, "stopReason": "manual" },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "stopped must have a stopReason", "action": "stop",
      "series": { "state": "stopped", "gamesUsed": 2, "realizedLoss": "0.00", "pending": null },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "max_games stopReason requires gamesUsed 15", "action": "stop",
      "series": { "state": "stopped", "gamesUsed": 10, "realizedLoss": "0.00", "pending": null, "stopReason": "max_games" },
      "expect": { "errorCode": "invalid_series" } },
    { "name": "invalid settlement result", "action": "settle", "result": "bogus", "targetProfit": "46.80",
      "series": { "state": "open", "gamesUsed": 0, "realizedLoss": "0.00", "pending": { "gameNumber": 1, "actualStake": "20.00", "odds": "3.34", "required": "20.00" } },
      "expect": { "errorCode": "invalid_result" } }
  ]
}
